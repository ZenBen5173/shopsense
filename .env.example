# ---- Database -------------------------------------------------------------
# Leave empty for the embedded PGlite database (zero setup, resets on restart).
# Set to a Supabase / Postgres URL for persistence (use the pooler URL on Vercel).
DATABASE_URL=
# Optional: persist PGlite to a folder locally instead of memory.
PGLITE_DIR=

# ---- Amazon Bedrock (AWS Builder) ------------------------------------------
# Any standard AWS credential source works (keys, AWS_PROFILE/SSO, Bedrock API key).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Models are swappable. For real shops, a cheaper vision model is recommended
# (e.g. global.anthropic.claude-haiku-4-5-20251001-v1:0 or global.amazon.nova-2-lite-v1:0).
BEDROCK_VISION_MODEL=global.anthropic.claude-opus-5-5
BEDROCK_TEXT_MODEL=global.anthropic.claude-opus-5-5
# Force offline perception even when AWS is configured:
# VISION_PROVIDER=sim

# ---- Ring Partner API ------------------------------------------------------
# For account linking (Ring Appstore app). Not needed for Playground tokens or the demo.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=
RING_WEBHOOK_SECRET=
# Point at ring-sandbox for offline development: http://127.0.0.1:8787
RING_API_BASE=

# ---- Ops -------------------------------------------------------------------
CRON_SECRET=
# Optional owner passcode: protects setup and every data-changing route.
# Open the app once as https://<host>/?key=<passcode>. Leave empty for a public demo.
SHOPSENSE_PASSCODE=
